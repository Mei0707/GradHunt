# Copy to .env and fill in. The agent service reads these via pydantic-settings.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Data layer (matches docker-compose ports) ---
DATABASE_URL=postgresql+psycopg://gradhunt:gradhunt@localhost:5433/gradhunt_agents
REDIS_URL=redis://localhost:6379/0

# --- Service ---
ENVIRONMENT=development
# Shared secret the Node gateway must send as X-Internal-Token. Leave blank to
# disable the check in local dev.
INTERNAL_API_TOKEN=

# Emit CloudWatch embedded metrics when stdout is shipped to CloudWatch Logs.
CLOUDWATCH_EMF=false
